# Copy to backend/.env for local dev. Never commit real values. See docs/OPS.md §4.1.
NODE_ENV=development
APP_ENV=local
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (niwa_dev database) or a local mongod
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=niwa_dev

# Optional locally (falls back to in-memory). Required on Render (Key Value internal URL).
REDIS_URL=

# >= 32 random chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=14

# first_user_only | open | closed
REGISTRATION_MODE=first_user_only

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173

# Cloudinary (M7)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=niwa/local

# DeepSeek key encryption, 32 bytes base64 (M8)
AI_ENCRYPTION_KEY=
