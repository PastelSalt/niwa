{
  "name": "@niwa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NIWA API (Express + MongoDB) — deployed to Render",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev-memory.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "admin": "node --env-file-if-exists=.env scripts/admin.ts",
    "scale-check": "node scripts/scale-check.ts"
  },
  "dependencies": {
    "@niwa/contracts": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "compression": "1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.2",
    "fractional-indexing": "^4.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "~5.0.5"
  }
}
