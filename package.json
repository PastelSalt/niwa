{
  "name": "niwa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @niwa/backend --filter @niwa/web dev",
    "start": "pnpm --filter @niwa/backend start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "pnpm --filter @niwa/contracts generate",
    "openapi:check": "pnpm --filter @niwa/contracts check",
    "dev:memory": "pnpm --parallel --filter @niwa/backend --filter @niwa/web dev:memory",
    "build": "pnpm --filter @niwa/web build",
    "e2e": "pnpm --filter @niwa/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
