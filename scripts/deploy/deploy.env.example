# Copy to scripts/deploy/deploy.env (git-ignored) and fill in. Never commit the real file.
# The deploy scripts read it; they never print these values.

# ---- Service tokens ----
# Render: Dashboard → Account settings → API keys
RENDER_API_KEY=
# Vercel: Account settings → Tokens (scope: your personal account)
VERCEL_TOKEN=

# ---- Backend secrets (Render env vars marked sync:false in render.yaml) ----
# Atlas SRV string for the niwa_prod database user (Network Access must allow 0.0.0.0/0 for Render)
MONGODB_URI=
# The web app's origin(s), comma-separated, e.g. https://niwa.vercel.app
CORS_ORIGINS=
# Optional: image uploads (leave empty to keep uploads off)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
